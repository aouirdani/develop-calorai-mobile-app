# ── CalorAI · configuration d'environnement ─────────────────────────────
# Copiez ce fichier en `.env` (jamais commité) pour le développement local.
#
# URL du backend calorie-vision, sans slash final.
# Laisser VIDE pour utiliser le MockApiClient (développement sans backend).
EXPO_PUBLIC_API_URL=
# Ancien alias accepté : EXPO_PUBLIC_CALORIEVISION_URL

# ⚠️ SÉCURITÉ : ne JAMAIS mettre de clé API privée ici pour la production.
# Le token doit provenir d'une future couche d'authentification et est
# conservé dans expo-secure-store (voir mobile/services/api/env.ts).

# Clé X-API-Key du backend — DEV LOCAL UNIQUEMENT.
# ⚠️ Les variables EXPO_PUBLIC_* sont embarquées en clair dans l'app : ne mettez
# jamais une clé de production ici. La prod devra passer par une authentification
# utilisateur/session ou un backend gateway (BFF).
EXPO_PUBLIC_API_KEY=

# true = force le MockApiClient même si EXPO_PUBLIC_API_URL est défini.
EXPO_PUBLIC_USE_MOCK=false
